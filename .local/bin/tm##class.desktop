#!/usr/bin/zsh

# No-op if not an interactive terminal
if [ ! -t 1 ]; then
  exit 0
fi

session=$(whoami)
current_dir=$(pwd)

# arguments are session name and window name
window_exists(){

    lines_found=$(tmux list-windows -t $1 2>/dev/null | grep ": $2" | wc -l)

    #echo "lines found with  $2: $lines_found  \n"
    (($lines_found>0))
}

init_notes(){
    # todo: maybe reintroduce the "what have i done" feature
    tmux neww  -k -n notes -t $1: "cd ~/notes; git pull;  /usr/bin/zsh"
}

init_herdr(){
    local herdr_command="herdr"

    # Remote mode relies on a Host devbox entry in the SSH config.
    # ssh -G evaluates the config without opening a connection.
    if ssh -G -v devbox 2>&1 >/dev/null | grep -q 'Applying options for devbox'; then
        herdr_command="herdr --remote devbox"
    fi

    tmux neww  -k -n HERDR -t $1: "$herdr_command; /usr/bin/zsh"
}

init_session(){
    tmux new-session -d -s $1;
    tmux rename-window -t $1:1 'o_0';
    tmux split-window -v -t $1:1;
}

# Check if the session exists
tmux has-session -t $session 2>/dev/null || init_session $session;

window_exists $session "notes" || init_notes $session 
window_exists $session "HERDR" || init_herdr $session

tmux attach -t $session
